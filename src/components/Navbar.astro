---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${base}/about`, label: 'Về chúng tôi', i18n: 'navAbout' },
  { href: `${base}/services`, label: 'Lĩnh vực & Dịch vụ', i18n: 'navServices' },
  { href: `${base}/projects`, label: 'Đối tác & Dự án', i18n: 'navProjects' },
  { href: `${base}/contact`, label: 'Liên hệ', i18n: 'navContact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="group flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center bg-[#0B1F3A] text-white transition-transform duration-300 group-hover:scale-105">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M4 18V6l8 6 8-6v12" />
        </svg>
      </div>
      <div class="leading-tight">
        <span class="block text-base font-bold tracking-wider text-[#0B1F3A]">JAPAN-TECH</span>
        <span class="block text-[10px] font-medium uppercase tracking-[0.18em] text-slate-500">Technology Transfer</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 lg:flex">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || currentPath === `${link.href}/`;
        return (
          <a
            href={link.href}
            data-i18n={link.i18n}
            class={`transition-colors hover:text-[#0B1F3A] ${isActive ? 'font-semibold text-[#0B1F3A]' : ''}`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <!-- Sliding Language Switcher -->
      <div
        id="lang-switcher"
        class="relative flex items-center rounded-full border border-slate-200 bg-slate-100 p-1 text-xs font-semibold text-slate-600"
      >
        <div
          id="lang-pill"
          class="absolute left-1 top-1 h-6 w-9 rounded-full bg-[#0B1F3A] transition-transform duration-300 ease-out"
        ></div>
        <button data-lang="vi" data-index="0" class="lang-btn relative z-10 h-6 w-9 cursor-pointer text-white transition-colors">VI</button>
        <button data-lang="ja" data-index="1" class="lang-btn relative z-10 h-6 w-9 cursor-pointer transition-colors hover:text-slate-900">JP</button>
        <button data-lang="en" data-index="2" class="lang-btn relative z-10 h-6 w-9 cursor-pointer transition-colors hover:text-slate-900">EN</button>
      </div>

      <a
        href={`${base}/contact`}
        data-i18n="navCta"
        class="hidden bg-[#0B1F3A] px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-white transition-colors hover:bg-[#173660] sm:inline-block"
      >
        Tư vấn ngay
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle Menu"
        class="flex h-10 w-10 cursor-pointer items-center justify-center border border-slate-200 text-slate-700 lg:hidden"
      >
        <svg id="icon-open" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 lg:hidden">
    <nav class="flex flex-col space-y-3 text-sm font-medium text-slate-700">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-i18n={link.i18n}
          class="border-b border-slate-100 py-2 transition-colors hover:text-[#0B1F3A]"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`${base}/contact`}
        data-i18n="navCta"
        class="mt-2 bg-[#0B1F3A] px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-white"
      >
        Tư vấn ngay
      </a>
    </nav>
  </div>

  <!-- 2px Scroll Progress Bar -->
  <div class="h-[2px] w-full bg-transparent">
    <div id="scroll-progress" class="h-full w-0 bg-[#0B1F3A] transition-[width] duration-75"></div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>