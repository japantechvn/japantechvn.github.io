---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const marqueeWords = ['JAPAN-TECH', '日本の技術', 'TECHNOLOGY TRANSFER', 'ベトナムの未来へ'];
---

<footer class="relative overflow-hidden bg-navy text-slate-300">
  <!-- Big closing CTA -->
  <section class="relative border-b border-white/10">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-24 sm:px-6 lg:pb-24 lg:pt-32">
      <p data-i18n="footerCtaEyebrow" class="reveal text-xs font-semibold uppercase tracking-[0.25em] text-sky-300">Bắt đầu dự án</p>
      <div class="mt-6 grid items-end gap-10 lg:grid-cols-12">
        <h2 class="text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-6xl lg:col-span-9 lg:text-7xl">
          <span class="mask"><span data-i18n="footerCtaTitle">Cùng kiến tạo tương lai bền vững.</span></span>
        </h2>
        <div class="reveal lg:col-span-3 lg:justify-self-end">
          <a
            href={`${base}/contact`}
            data-magnetic
            class="group relative flex h-36 w-36 items-center justify-center rounded-full bg-white text-center text-sm font-semibold text-navy transition-colors duration-500 hover:bg-sky-300 sm:h-44 sm:w-44"
          >
            <span class="flex flex-col items-center gap-2">
              <span data-i18n="footerCtaBtn">Liên hệ ngay</span>
              <svg class="h-5 w-5 transition-transform duration-500 group-hover:-rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7" /></svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Outlined marquee -->
    <div class="marquee pb-10 text-white/15" aria-hidden="true">
      <div class="marquee-track" style="--speed: 50s">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {marqueeWords.map((w) => (
              <span class="text-outline px-8 font-jp text-6xl font-bold tracking-tight whitespace-nowrap sm:text-8xl">
                {w} <span class="ml-8 text-sky-400/40">✦</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Info columns -->
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <span data-i18n="footerBrand" class="text-lg font-bold tracking-wider text-white">CÔNG TY TNHH JAPAN-TECH</span>
      <p data-i18n="footerDesc" class="mt-3 max-w-md text-sm leading-relaxed text-slate-400">
        Đối tác tin cậy trong chuyển giao công nghệ tiên tiến từ Nhật Bản, hướng tới phát triển bền vững cho doanh nghiệp Việt Nam.
      </p>
      <p class="mt-6 text-sm text-slate-400">contact@japantech.vn · +84 (0) 900 000 000</p>
    </div>
    <div>
      <h4 data-i18n="footerNavTitle" class="text-xs font-bold uppercase tracking-widest text-white">Điều hướng</h4>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={`${base}/about`} data-i18n="navAbout" class="footer-link">Về chúng tôi</a></li>
        <li><a href={`${base}/services`} data-i18n="navServices" class="footer-link">Lĩnh vực & Dịch vụ</a></li>
        <li><a href={`${base}/projects`} data-i18n="navProjects" class="footer-link">Đối tác & Dự án</a></li>
        <li><a href={`${base}/contact`} data-i18n="navContact" class="footer-link">Liên hệ</a></li>
      </ul>
    </div>
    <div>
      <h4 data-i18n="footerLangTitle" class="text-xs font-bold uppercase tracking-widest text-white">Ngôn ngữ</h4>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><button data-lang="vi" class="footer-lang cursor-pointer">Tiếng Việt (VI)</button></li>
        <li><button data-lang="ja" class="footer-lang cursor-pointer">日本語 (JP)</button></li>
        <li><button data-lang="en" class="footer-lang cursor-pointer">English (EN)</button></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:px-6">
      <span data-i18n="footerCopy">© 2026 Công ty TNHH Japan-Tech. All rights reserved.</span>
      <button id="back-to-top" class="group flex cursor-pointer items-center gap-2 uppercase tracking-widest transition-colors hover:text-white">
        <span data-i18n="backToTop">Lên đầu trang</span>
        <svg class="h-4 w-4 transition-transform duration-500 group-hover:-translate-y-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 19V5m-7 7 7-7 7 7" /></svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .footer-link,
  .footer-lang {
    position: relative;
    transition: color 0.3s;
  }
  .footer-link:hover,
  .footer-lang:hover,
  .footer-lang.is-active {
    color: #fff;
  }
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-wipe);
  }
  .footer-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
