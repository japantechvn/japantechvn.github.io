---
interface Props {
  eyebrow: string;      // English label, also used as giant outlined background word
  jp: string;           // decorative Japanese label
  title: string;
  titleKey: string;
  desc: string;
  descKey: string;
  image?: string;
}

const { eyebrow, jp, title, titleKey, desc, descKey, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative overflow-hidden bg-navy text-white">
  {image && (
    <div class="absolute inset-0 overflow-hidden">
      <img src={image} alt="" class="kenburns h-full w-full object-cover opacity-25" />
    </div>
  )}
  <div class="absolute inset-0 bg-linear-to-r from-navy via-navy/90 to-navy/50"></div>
  <div class="grid-drift pointer-events-none absolute inset-0"></div>

  <!-- Giant outlined word drifting with scroll -->
  <p
    data-parallax="-0.15"
    class="text-outline pointer-events-none absolute -bottom-6 right-0 text-[18vw] font-extrabold uppercase leading-none whitespace-nowrap text-white/10 lg:text-[12vw]"
    aria-hidden="true"
  >
    {eyebrow.split(' ')[0]}
  </p>

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-40 sm:px-6 lg:pb-28 lg:pt-48">
    <nav class="reveal flex items-center gap-3 text-xs text-slate-400" aria-label="Breadcrumb">
      <a href={`${base}/`} data-i18n="navHome" class="transition-colors hover:text-white">Trang chủ</a>
      <span class="h-px w-6 bg-slate-500"></span>
      <span class="text-sky-300">{eyebrow}</span>
    </nav>

    <p class="reveal mt-8 flex items-center gap-4 text-xs font-semibold uppercase tracking-[0.25em] text-sky-300">
      {eyebrow}<span class="font-jp tracking-[0.3em] text-white/40">{jp}</span>
    </p>
    <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-[1.1] tracking-tight sm:text-6xl">
      <span class="mask" style="--d: 0.1s"><span data-i18n={titleKey}>{title}</span></span>
    </h1>
    <p data-i18n={descKey} class="reveal mt-6 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base" style="transition-delay: 0.25s">
      {desc}
    </p>
    <div class="draw-line mt-14 h-px bg-white/20" style="--d: 0.4s"></div>
  </div>
</section>
