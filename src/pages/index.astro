---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const IMG = {
  hero: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2000&q=80',
  office: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=80',
  agri: 'https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?auto=format&fit=crop&w=1200&q=80',
  factory: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1200&q=80',
};

const services = [
  { id: 'srv1', num: '01', title: 'Nông nghiệp tuần hoàn', enTitle: 'Circular Agriculture', desc: 'Chuyển giao hệ thống canh tác hữu cơ khép kín, tái sử dụng phụ phẩm nông nghiệp và công nghệ vi sinh chuẩn Nhật Bản giúp tăng năng suất bền vững.', img: IMG.agri },
  { id: 'srv2', num: '02', title: 'Xử lý chất thải & Môi trường', enTitle: 'Environmental Solutions', desc: 'Công nghệ xử lý nước thải công nghiệp, rác thải hữu cơ và kiểm soát khí thải đạt chuẩn QCVN & tiêu chuẩn môi trường Nhật Bản.', img: IMG.factory },
  { id: 'srv3', num: '03', title: 'Tự động hóa & Sản xuất thông minh', enTitle: 'Smart Manufacturing', desc: 'Tư vấn và tích hợp dây chuyền sản xuất tinh gọn (Kaizen/Lean), cảm biến IoT giám sát vận hành và tối ưu hóa chi phí năng lượng nhà máy.', img: IMG.hero },
  { id: 'srv4', num: '04', title: 'Tư vấn & Đào tạo kỹ thuật', enTitle: 'Technical Advisory', desc: 'Kết nối trực tiếp đội ngũ kỹ sư Nhật Bản khảo sát thực địa, đào tạo nhân sự vận hành và đồng hành bảo trì dài hạn cho doanh nghiệp.', img: IMG.office },
];

const processSteps = [
  { id: 'proc1', step: '01', title: 'Khảo sát & Đánh giá', desc: 'Tiếp nhận nhu cầu, khảo sát thực tế tại nhà máy/trang trại và phân tích bài toán kỹ thuật.' },
  { id: 'proc2', step: '02', title: 'Thiết kế giải pháp', desc: 'Phối hợp với đối tác Nhật Bản xây dựng phương án công nghệ tối ưu chi phí và hiệu suất.' },
  { id: 'proc3', step: '03', title: 'Chuyển giao & Lắp đặt', desc: 'Nhập khẩu thiết bị, thi công lắp đặt và hiệu chỉnh hệ thống theo tiêu chuẩn kỹ thuật nghiêm ngặt.' },
  { id: 'proc4', step: '04', title: 'Đào tạo & Đồng hành', desc: 'Bàn giao quy trình vận hành, đào tạo đội ngũ kỹ thuật viên và bảo trì định kỳ dài hạn.' },
];

const projects = [
  { id: 'proj1', category: 'Nông nghiệp tuần hoàn', title: 'Hệ thống xử lý phụ phẩm nông nghiệp thành phân bón hữu cơ sinh học', location: 'Lâm Đồng, Việt Nam · 2025', tech: 'Công nghệ lên men nhiệt cao từ Nhật Bản (Bioreactor System)', result: 'Rút ngắn thời gian ủ từ 60 ngày xuống 14 ngày, giảm 85% mùi phát sinh.', stat: '-77%', img: IMG.agri },
  { id: 'proj2', category: 'Xử lý môi trường', title: 'Trạm xử lý nước thải tuần hoàn cho nhà máy chế biến thực phẩm', location: 'Bình Dương, Việt Nam · 2025', tech: 'Màng lọc sinh học MBR & Hệ thống giám sát tự động chuẩn Nhật', result: 'Tái sử dụng 65% lượng nước đầu ra, tiết kiệm 30% điện năng vận hành.', stat: '65%', img: IMG.factory },
];

const keywords = ['Circular Agriculture', '循環型農業', 'Environmental Solutions', '環境ソリューション', 'Smart Manufacturing', 'スマート製造', 'Technical Advisory', '技術コンサルティング'];
const partners = ['NIPPON ECO', 'KANSAI BIO', 'TOKYO AGRI', 'KYOTO TECH', 'OSAKA LABS', 'HIROSHIMA GREEN'];
---

<Layout title="Công ty TNHH Japan-Tech | Chuyển Giao Công Nghệ Nhật Bản">
  <!-- ═════════ 1. HERO ═════════ -->
  <section class="relative flex min-h-svh flex-col overflow-hidden bg-navy text-white">
    <div class="absolute inset-0 overflow-hidden">
      <img src={IMG.hero} alt="" class="kenburns h-full w-full object-cover opacity-45" fetchpriority="high" />
    </div>
    <div class="absolute inset-0 bg-linear-to-r from-navy via-navy/85 to-navy/30"></div>
    <div class="grid-drift pointer-events-none absolute inset-0"></div>

    <!-- Decorative vertical Japanese -->
    <p class="vertical-jp reveal absolute right-8 top-36 hidden text-sm text-white/50 xl:block" aria-hidden="true">
      技術で、日越の未来をつなぐ。
    </p>

    <div class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-16 pt-36 sm:px-6">
      <div class="reveal mb-7 inline-flex w-fit items-center gap-3 text-[11px] font-medium uppercase tracking-[0.25em] text-sky-200 sm:text-xs">
        <span class="h-px w-10 bg-sky-300"></span>
        <span data-i18n="heroBadge">Japan – Vietnam Technology Transfer</span>
      </div>

      <h1 class="max-w-5xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-6xl lg:text-[80px]">
        <span class="mask" style="--d: 0.1s"><span data-i18n="heroTitle">Cầu nối chuyển giao công nghệ tiên tiến từ Nhật Bản.</span></span>
      </h1>

      <p data-i18n="heroDesc" class="reveal mt-8 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-lg" style="transition-delay: 0.3s">
        Công ty TNHH Japan-Tech đồng hành cùng doanh nghiệp Việt Nam triển khai các giải pháp nông nghiệp tuần hoàn, xử lý môi trường và tối ưu hóa vận hành theo tiêu chuẩn kỹ thuật Nhật Bản.
      </p>

      <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4" style="transition-delay: 0.45s">
        <a href={`${base}/contact`} data-magnetic class="btn-sweep group inline-flex items-center justify-center gap-3 bg-white px-8 py-4 text-sm font-semibold text-navy" style="--sweep: #e0f2fe">
          <span data-i18n="heroBtnPrimary">Liên hệ tư vấn dự án</span>
          <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7" /></svg>
        </a>
        <a href={`${base}/services`} data-i18n="heroBtnSecondary" class="btn-sweep inline-flex items-center justify-center border border-white/30 px-8 py-4 text-sm font-medium text-white" style="--sweep: rgb(255 255 255 / 0.1)">
          Khám phá lĩnh vực
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-36 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 md:flex lg:bottom-40" aria-hidden="true">
      <span class="text-[10px] uppercase tracking-[0.3em] text-white/50">Scroll</span>
      <span class="scroll-cue block h-14 w-px bg-white/20"></span>
    </div>

    <!-- Metrics strip -->
    <div class="relative border-t border-white/10 bg-navy-deep/80 backdrop-blur">
      <div class="reveal-stagger mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-7 sm:px-6 md:grid-cols-4 md:py-8">
        <div>
          <p class="counter text-3xl font-bold text-white sm:text-4xl" data-target="100" data-suffix="%">100%</p>
          <p data-i18n="metric1" class="mt-1 text-xs text-slate-400 sm:text-sm">Công nghệ chuẩn Nhật Bản</p>
        </div>
        <div>
          <p class="counter text-3xl font-bold text-white sm:text-4xl" data-target="4" data-suffix="+" data-pad="true">04+</p>
          <p data-i18n="metric2" class="mt-1 text-xs text-slate-400 sm:text-sm">Lĩnh vực chuyển giao cốt lõi</p>
        </div>
        <div>
          <p class="counter text-3xl font-bold text-white sm:text-4xl" data-target="10" data-suffix="+">10+</p>
          <p data-i18n="metric3" class="mt-1 text-xs text-slate-400 sm:text-sm">Đối tác kỹ thuật Nhật Bản</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-white sm:text-4xl">VI·JP·EN</p>
          <p data-i18n="metric4" class="mt-1 text-xs text-slate-400 sm:text-sm">Đội ngũ điều phối đa ngôn ngữ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ 2. KEYWORD + PARTNER MARQUEES ═════════ -->
  <section class="border-b border-slate-200 bg-white py-10" aria-label="Partners">
    <div class="marquee text-navy">
      <div class="marquee-track" style="--speed: 45s">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center" aria-hidden="true">
            {keywords.map((k) => (
              <span class="flex items-center whitespace-nowrap px-6 text-2xl font-bold tracking-tight sm:text-4xl">
                {k}<span class="ml-12 h-2 w-2 rotate-45 bg-sky-500"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p data-i18n="partnersLabel" class="mt-10 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-400 sm:text-xs">
      Đối tác công nghệ & Khách hàng tiêu biểu (Logo minh họa)
    </p>
    <div class="marquee mt-6">
      <div class="marquee-track reverse" style="--speed: 35s">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {partners.map((p) => (
              <span class="flex items-center gap-3 whitespace-nowrap px-10 text-sm font-bold tracking-[0.2em] text-slate-400 transition-colors hover:text-navy">
                <span class="h-3.5 w-3.5 border-2 border-current"></span>{p}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ 3. ABOUT STATEMENT ═════════ -->
  <section id="about" class="bg-white py-24 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p data-i18n="aboutEyebrow" class="reveal text-xs font-bold uppercase tracking-[0.2em] text-sky-700">01 / Về chúng tôi</p>
        </div>
        <div class="lg:col-span-9">
          <h2 class="text-3xl font-bold leading-[1.2] tracking-tight text-navy sm:text-5xl">
            <span class="mask"><span data-i18n="aboutTitle">Đưa tinh hoa kỹ thuật Nhật Bản vào thực tiễn doanh nghiệp Việt Nam.</span></span>
          </h2>
          <div class="mt-10 grid gap-8 md:grid-cols-2">
            <p data-i18n="aboutDesc1" class="reveal text-sm leading-relaxed text-slate-600 sm:text-base">
              Công ty TNHH Japan-Tech được thành lập với sứ mệnh trở thành cầu nối công nghệ tin cậy giữa Nhật Bản và Việt Nam. Chúng tôi không chỉ cung cấp thiết bị mà còn chuyển giao trọn gói quy trình vận hành, tư duy quản trị chất lượng và cam kết đồng hành lâu dài cùng đối tác.
            </p>
            <div class="reveal flex items-end">
              <a href={`${base}/about`} class="group inline-flex items-center gap-4 text-sm font-semibold text-navy">
                <span data-i18n="aboutMore">Tìm hiểu thêm về chúng tôi</span>
                <span class="flex h-12 w-12 items-center justify-center rounded-full border border-navy/20 transition-all duration-500 group-hover:bg-navy group-hover:text-white">
                  <svg class="h-4 w-4 transition-transform duration-500 group-hover:-rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7" /></svg>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Wide image with wipe + parallax -->
      <div class="img-reveal relative mt-20 h-[320px] sm:h-[460px] lg:h-[560px]">
        <img src={IMG.office} alt="Japan-Tech workspace" data-parallax="0.08" class="h-full w-full object-cover" loading="lazy" />
        <div class="absolute bottom-0 left-0 bg-white px-6 py-4 text-xs text-slate-500 sm:px-8">
          <span class="font-jp tracking-[0.3em] text-navy">日越技術移転</span> · Japan-Tech Co., Ltd.
        </div>
      </div>

      <!-- Vision / Mission -->
      <div class="mt-16 grid gap-12 md:grid-cols-2">
        <div>
          <div class="draw-line h-px bg-navy"></div>
          <p class="reveal mt-6 font-mono text-xs text-sky-700">VISION · ビジョン</p>
          <h3 data-i18n="visionTitle" class="reveal mt-2 text-2xl font-bold text-navy">Tầm nhìn</h3>
          <p data-i18n="visionDesc" class="reveal mt-3 text-sm leading-relaxed text-slate-600">
            Trở thành đơn vị tiên phong tại Việt Nam trong lĩnh vực chuyển giao công nghệ xanh và giải pháp sản xuất bền vững từ Nhật Bản.
          </p>
        </div>
        <div>
          <div class="draw-line h-px bg-navy" style="--d: 0.2s"></div>
          <p class="reveal mt-6 font-mono text-xs text-sky-700">MISSION · ミッション</p>
          <h3 data-i18n="missionTitle" class="reveal mt-2 text-2xl font-bold text-navy">Sứ mệnh</h3>
          <p data-i18n="missionDesc" class="reveal mt-3 text-sm leading-relaxed text-slate-600">
            Nâng cao năng lực cạnh tranh cho doanh nghiệp Việt thông qua công nghệ chuẩn xác, thân thiện môi trường và hiệu quả kinh tế cao.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ 4. SERVICES — numbered rows ═════════ -->
  <section id="services" class="bg-slate-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p data-i18n="servicesEyebrow" class="reveal text-xs font-bold uppercase tracking-[0.2em] text-sky-700">02 / Lĩnh vực & Dịch vụ</p>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-navy sm:text-5xl">
            <span class="mask"><span data-i18n="servicesTitle">Giải pháp công nghệ chuyển giao cốt lõi</span></span>
          </h2>
        </div>
        <a href={`${base}/services`} data-i18n="srvMore" class="reveal shrink-0 text-sm font-semibold text-navy">Xem tất cả dịch vụ →</a>
      </div>

      <div class="reveal-stagger mt-14 border-b border-slate-300">
        {services.map((item) => (
          <a href={`${base}/services`} data-hover-img={item.img} class="group relative block overflow-hidden border-t border-slate-300">
            <span class="absolute inset-0 origin-bottom scale-y-0 bg-navy transition-transform duration-700 ease-[cubic-bezier(0.77,0,0.18,1)] group-hover:scale-y-100"></span>
            <div class="relative grid gap-3 px-2 py-8 transition-colors duration-500 group-hover:text-white sm:px-6 lg:grid-cols-12 lg:items-center lg:gap-8 lg:py-10">
              <span class="font-mono text-sm text-slate-400 transition-colors group-hover:text-sky-300 lg:col-span-1">{item.num}</span>
              <div class="lg:col-span-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-sky-700 transition-colors group-hover:text-sky-300">{item.enTitle}</p>
                <h3 data-i18n={`${item.id}Title`} class="mt-1 text-2xl font-bold transition-transform duration-500 group-hover:translate-x-2 sm:text-3xl">{item.title}</h3>
              </div>
              <p data-i18n={`${item.id}Desc`} class="text-sm leading-relaxed text-slate-600 transition-colors group-hover:text-slate-300 lg:col-span-5">{item.desc}</p>
              <span class="hidden h-12 w-12 items-center justify-center justify-self-end rounded-full border border-current/30 transition-all duration-500 group-hover:-rotate-45 group-hover:bg-white group-hover:text-navy lg:col-span-1 lg:flex">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ 5. PROCESS — sticky title + progress line ═════════ -->
  <section id="process" class="relative overflow-hidden bg-navy py-24 text-white lg:py-36">
    <div class="grid-drift pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="relative mx-auto grid max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p data-i18n="processEyebrow" class="reveal text-xs font-bold uppercase tracking-[0.2em] text-sky-300">03 / Quy trình làm việc</p>
          <h2 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
            <span class="mask"><span data-i18n="processTitle">Quy trình triển khai chuẩn mực 4 bước</span></span>
          </h2>
          <p data-i18n="processDesc" class="reveal mt-6 max-w-md text-sm leading-relaxed text-slate-400">
            Từ khảo sát đến vận hành, mỗi bước đều được kiểm soát theo tiêu chuẩn chất lượng Nhật Bản.
          </p>
          <p class="reveal mt-10 hidden font-jp text-[120px] font-bold leading-none text-white/5 lg:block" aria-hidden="true">工程</p>
        </div>
      </div>

      <div class="relative lg:col-span-7" data-process>
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/15">
          <div class="process-line h-full w-full bg-sky-400"></div>
        </div>
        <ol class="space-y-16 lg:space-y-24">
          {processSteps.map((s) => (
            <li data-step class="relative pl-12">
              <span class="step-dot absolute left-0 top-2 h-[15px] w-[15px] rounded-full border-2 border-navy bg-white/40"></span>
              <span class="font-mono text-6xl font-bold text-white/10 sm:text-7xl">{s.step}</span>
              <p class="mt-2 text-xs font-bold tracking-widest text-sky-300"><span data-i18n="stepLabel">BƯỚC</span> {s.step}</p>
              <h3 data-i18n={`${s.id}Title`} class="mt-2 text-2xl font-bold">{s.title}</h3>
              <p data-i18n={`${s.id}Desc`} class="mt-3 max-w-md text-sm leading-relaxed text-slate-400">{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═════════ 6. PROJECTS — alternating showcase ═════════ -->
  <section id="projects" class="bg-white py-24 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p data-i18n="projectsEyebrow" class="reveal text-xs font-bold uppercase tracking-[0.2em] text-sky-700">04 / Dự án tiêu biểu</p>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-navy sm:text-5xl">
            <span class="mask"><span data-i18n="projectsTitle">Hiệu quả thực tế từ các dự án đã triển khai</span></span>
          </h2>
        </div>
        <a href={`${base}/projects`} data-i18n="projMore" class="reveal shrink-0 text-sm font-semibold text-navy">Xem tất cả dự án →</a>
      </div>

      <div class="mt-16 space-y-24 lg:space-y-32">
        {projects.map((p, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
            <a href={`${base}/projects`} class:list={['img-reveal group relative block h-[300px] sm:h-[420px] lg:col-span-7 lg:h-[520px]', { 'lg:order-2': i % 2 === 1 }]}>
              <img src={p.img} alt={p.title} data-parallax="0.06" class="h-full w-full object-cover transition-[filter] duration-700 group-hover:brightness-110" loading="lazy" />
              <span data-i18n={`${p.id}Cat`} class="absolute left-0 top-0 bg-navy px-4 py-2 text-xs font-semibold text-white">{p.category}</span>
            </a>
            <div class="lg:col-span-5">
              <p class="reveal font-mono text-xs text-slate-400">{String(i + 1).padStart(2, '0')} — {p.location}</p>
              <h3 data-i18n={`${p.id}Title`} class="reveal mt-3 text-2xl font-bold leading-snug text-navy sm:text-3xl">{p.title}</h3>
              <div class="draw-line mt-8 h-px bg-slate-200"></div>
              <p class="reveal mt-6 text-6xl font-bold tracking-tight text-sky-600 sm:text-7xl">{p.stat}</p>
              <p data-i18n={`${p.id}Result`} class="reveal mt-3 text-sm leading-relaxed text-slate-600">{p.result}</p>
              <p class="reveal mt-6 text-sm text-slate-600">
                <strong data-i18n="projTechLabel" class="text-slate-900">Công nghệ áp dụng:</strong>{' '}
                <span data-i18n={`${p.id}Tech`}>{p.tech}</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
