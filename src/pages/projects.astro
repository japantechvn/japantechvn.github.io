---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  { id: 'proj1', category: 'Nông nghiệp tuần hoàn', title: 'Hệ thống xử lý phụ phẩm nông nghiệp thành phân bón hữu cơ sinh học', location: 'Lâm Đồng, Việt Nam · 2025', img: 'https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?auto=format&fit=crop&w=1000&q=80' },
  { id: 'proj2', category: 'Xử lý môi trường', title: 'Trạm xử lý nước thải tuần hoàn cho nhà máy chế biến thực phẩm', location: 'Bình Dương, Việt Nam · 2025', img: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1000&q=80' },
];

const partners = [
  { id: 'part1', name: 'NIPPON ECO CORP.', origin: 'Tokyo, Japan' },
  { id: 'part2', name: 'KANSAI BIO LABS', origin: 'Osaka, Japan' },
  { id: 'part3', name: 'KYOTO PRECISION TECH', origin: 'Kyoto, Japan' },
  { id: 'part4', name: 'HIROSHIMA GREEN SYSTEMS', origin: 'Hiroshima, Japan' },
];
---

<Layout title="Đối tác & Dự án | Công ty TNHH Japan-Tech">
  <PageHero
    eyebrow="Projects"
    jp="導入実績"
    titleKey="projPageTitle"
    title="Đối tác & Dự án tiêu biểu"
    descKey="projPageDesc"
    desc="Hiệu quả thực tế được kiểm chứng thông qua mạng lưới đối tác kỹ thuật Nhật Bản và các công trình đã bàn giao tại Việt Nam."
    image="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1800&q=80"
  />

  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-7xl space-y-10 px-4 sm:px-6">
      {projects.map((p) => (
        <article class="reveal grid overflow-hidden border border-slate-200 bg-white lg:grid-cols-12">
          <div class="img-reveal relative min-h-[260px] bg-slate-200 lg:col-span-5">
            <img src={p.img} alt={p.title} data-parallax="0.05" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <span data-i18n={`${p.id}Cat`} class="absolute left-4 top-4 bg-[#0B1F3A] px-3 py-1 text-xs font-semibold text-white">
              {p.category}
            </span>
          </div>
          <div class="p-6 lg:col-span-7 lg:p-10">
            <p class="text-xs font-medium text-slate-500">{p.location}</p>
            <h2 data-i18n={`${p.id}Title`} class="mt-2 text-xl font-bold text-slate-900 sm:text-2xl">{p.title}</h2>

            <div class="mt-6 space-y-4 border-t border-slate-100 pt-6 text-sm leading-relaxed">
              <div>
                <span data-i18n="projChallengeLabel" class="font-bold text-slate-900">Bài toán thực tế:</span>{' '}
                <span data-i18n={`${p.id}Challenge`} class="text-slate-600"></span>
              </div>
              <div>
                <span data-i18n="projTechLabel" class="font-bold text-slate-900">Công nghệ áp dụng:</span>{' '}
                <span data-i18n={`${p.id}Tech`} class="text-slate-600"></span>
              </div>
              <div class="border-l-2 border-[#0B1F3A] bg-slate-50 p-4">
                <span data-i18n="projResultLabel" class="font-bold text-[#0B1F3A]">Kết quả đạt được:</span>{' '}
                <span data-i18n={`${p.id}Result`} class="text-slate-700"></span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0B1F3A]">Partners</p>
        <h2 data-i18n="partnersPageTitle" class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">Mạng lưới đối tác công nghệ Nhật Bản</h2>
      </div>

      <div class="reveal-stagger mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {partners.map((partner) => (
          <div class="border border-slate-200 bg-white p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center bg-slate-100 font-bold text-[#0B1F3A]">JP</div>
            <h3 class="text-base font-bold text-slate-900">{partner.name}</h3>
            <p class="mt-1 text-xs font-medium text-sky-700">{partner.origin}</p>
            <p data-i18n={`${partner.id}Field`} class="mt-3 text-xs text-slate-600"></p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a href={`${base}/contact`} data-i18n="projCta" class="inline-flex items-center gap-2 bg-[#0B1F3A] px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#173660]">
          Trao đổi về dự án của bạn
        </a>
      </div>
    </div>
  </section>
</Layout>