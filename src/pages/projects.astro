---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    category: 'Nông nghiệp tuần hoàn',
    title: 'Hệ thống xử lý phụ phẩm nông nghiệp thành phân bón hữu cơ sinh học',
    location: 'Lâm Đồng, Việt Nam · 2025',
    challenge: 'Lượng phụ phẩm nông nghiệp lớn gây ô nhiễm mùi, thời gian ủ truyền thống kéo dài trên 60 ngày và chất lượng phân bón không đồng đều.',
    tech: 'Công nghệ lên men nhiệt cao khép kín (Bioreactor System) & chế phẩm vi sinh Nhật Bản.',
    result: 'Rút ngắn thời gian xử lý xuống còn 14 ngày, giảm 85% mùi phát sinh và tạo nguồn phân hữu cơ đạt chuẩn xuất khẩu.',
    img: 'https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?auto=format&fit=crop&w=1000&q=80',
  },
  {
    category: 'Xử lý môi trường',
    title: 'Trạm xử lý nước thải tuần hoàn cho nhà máy chế biến thực phẩm',
    location: 'Bình Dương, Việt Nam · 2025',
    challenge: 'Nước thải sản xuất có tải lượng hữu cơ (COD/BOD) cao, chi phí vận hành trạm xử lý cũ lớn và không thể tái sử dụng.',
    tech: 'Màng lọc sinh học MBR hiệu suất cao kết hợp hệ thống điều khiển tự động chuẩn Nhật.',
    result: 'Nước đầu ra đạt chuẩn cột A, tái sử dụng 65% lượng nước cho vệ sinh công nghiệp và tiết kiệm 30% điện năng.',
    img: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1000&q=80',
  },
];

const partners = [
  { name: 'NIPPON ECO CORP.', origin: 'Tokyo, Nhật Bản', field: 'Công nghệ xử lý môi trường' },
  { name: 'KANSAI BIO LABS', origin: 'Osaka, Nhật Bản', field: 'Vi sinh nông nghiệp tuần hoàn' },
  { name: 'KYOTO PRECISION TECH', origin: 'Kyoto, Nhật Bản', field: 'Cảm biến & Tự động hóa' },
  { name: 'HIROSHIMA GREEN SYSTEMS', origin: 'Hiroshima, Nhật Bản', field: 'Tái tạo năng lượng & Xử lý chất thải' },
];
---

<Layout title="Đối tác & Dự án | Công ty TNHH Japan-Tech">
  <!-- Page Header -->
  <section class="bg-[#0B1F3A] py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Proof & Trust</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Đối tác & Dự án tiêu biểu</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        Hiệu quả thực tế được kiểm chứng thông qua mạng lưới đối tác kỹ thuật Nhật Bản và các công trình đã bàn giao tại Việt Nam.
      </p>
    </div>
  </section>

  <!-- Detailed Case Studies -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl space-y-12 px-6">
      {projects.map((p) => (
        <article class="reveal grid overflow-hidden border border-slate-200 bg-white lg:grid-cols-12">
          <div class="relative min-h-[280px] bg-slate-200 lg:col-span-5">
            <img src={p.img} alt={p.title} class="h-full w-full object-cover" />
            <span class="absolute left-4 top-4 bg-[#0B1F3A] px-3 py-1 text-xs font-semibold text-white">
              {p.category}
            </span>
          </div>
          <div class="p-8 lg:col-span-7 lg:p-10">
            <p class="text-xs font-medium text-slate-500">{p.location}</p>
            <h2 class="mt-2 text-2xl font-bold text-slate-900">{p.title}</h2>

            <div class="mt-6 space-y-4 border-t border-slate-100 pt-6 text-sm leading-relaxed">
              <div>
                <span class="font-bold text-slate-900">Bài toán thực tế: </span>
                <span class="text-slate-600">{p.challenge}</span>
              </div>
              <div>
                <span class="font-bold text-slate-900">Công nghệ áp dụng: </span>
                <span class="text-slate-600">{p.tech}</span>
              </div>
              <div class="border-l-2 border-[#0B1F3A] bg-slate-50 p-4">
                <span class="font-bold text-[#0B1F3A]">Kết quả đạt được: </span>
                <span class="text-slate-700">{p.result}</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Japanese Partner Directory -->
  <section class="border-t border-slate-200 bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0B1F3A]">Partners</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900">Mạng lưới đối tác công nghệ Nhật Bản</h2>
        <p class="mt-2 text-sm text-slate-500">*(Danh sách minh họa – thay thế bằng tên và logo đối tác chính thức của công ty)*</p>
      </div>

      <div class="reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {partners.map((partner) => (
          <div class="border border-slate-200 bg-white p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center bg-slate-100 font-bold text-[#0B1F3A]">
              JP
            </div>
            <h3 class="text-base font-bold text-slate-900">{partner.name}</h3>
            <p class="mt-1 text-xs font-medium text-sky-700">{partner.origin}</p>
            <p class="mt-3 text-xs text-slate-600">{partner.field}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a
          href={`${base}/contact`}
          class="inline-flex items-center gap-2 bg-[#0B1F3A] px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#173660]"
        >
          Trao đổi về dự án của bạn
        </a>
      </div>
    </div>
  </section>
</Layout>