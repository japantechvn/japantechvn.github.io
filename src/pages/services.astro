---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  { id: 'srv1', num: '01', enTitle: 'Circular Agriculture', title: 'Nông nghiệp tuần hoàn', desc: 'Chuyển giao hệ thống canh tác hữu cơ khép kín, tái sử dụng phụ phẩm nông nghiệp và công nghệ vi sinh chuẩn Nhật Bản giúp tăng năng suất bền vững.', highlights: ['H1', 'H2', 'H3'] },
  { id: 'srv2', num: '02', enTitle: 'Environmental Engineering', title: 'Xử lý chất thải & Môi trường', desc: 'Công nghệ xử lý nước thải công nghiệp, rác thải hữu cơ và kiểm soát khí thải đạt chuẩn QCVN & tiêu chuẩn môi trường Nhật Bản.', highlights: ['H1', 'H2', 'H3'] },
  { id: 'srv3', num: '03', enTitle: 'Smart Manufacturing', title: 'Tự động hóa & Sản xuất thông minh', desc: 'Tư vấn và tích hợp dây chuyền sản xuất tinh gọn (Kaizen/Lean), cảm biến IoT giám sát vận hành và tối ưu hóa chi phí năng lượng nhà máy.', highlights: ['H1', 'H2', 'H3'] },
  { id: 'srv4', num: '04', enTitle: 'Technical Advisory & Training', title: 'Tư vấn & Đào tạo kỹ thuật', desc: 'Kết nối trực tiếp đội ngũ kỹ sư Nhật Bản khảo sát thực địa, đào tạo nhân sự vận hành và đồng hành bảo trì dài hạn cho doanh nghiệp.', highlights: ['H1', 'H2', 'H3'] },
];

const processSteps = [
  { id: 'proc1', step: '01', title: 'Khảo sát & Đánh giá', desc: 'Tiếp nhận nhu cầu, khảo sát thực tế tại nhà máy/trang trại và phân tích bài toán kỹ thuật.' },
  { id: 'proc2', step: '02', title: 'Thiết kế giải pháp', desc: 'Phối hợp với đối tác Nhật Bản xây dựng phương án công nghệ tối ưu chi phí và hiệu suất.' },
  { id: 'proc3', step: '03', title: 'Chuyển giao & Lắp đặt', desc: 'Nhập khẩu thiết bị, thi công lắp đặt và hiệu chỉnh hệ thống theo tiêu chuẩn kỹ thuật nghiêm ngặt.' },
  { id: 'proc4', step: '04', title: 'Đào tạo & Đồng hành', desc: 'Bàn giao quy trình vận hành, đào tạo đội ngũ kỹ thuật viên và bảo trì định kỳ dài hạn.' },
];
---

<Layout title="Lĩnh vực & Dịch vụ | Công ty TNHH Japan-Tech">
  <PageHero
    eyebrow="Services"
    jp="事業内容"
    titleKey="srvPageTitle"
    title="Lĩnh vực công nghệ & Dịch vụ"
    descKey="srvPageDesc"
    desc="Các giải pháp chuyển giao công nghệ được chọn lọc từ Nhật Bản và tinh chỉnh phù hợp với điều kiện vận hành tại Việt Nam."
    image="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1800&q=80"
  />

  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-7xl space-y-6 px-4 sm:space-y-8 sm:px-6">
      {services.map((item) => (
        <div class="reveal grid gap-6 border border-slate-200 bg-white p-6 transition-colors hover:border-[#0B1F3A] lg:grid-cols-12 lg:gap-8 lg:p-10">
          <div class="lg:col-span-5">
            <span class="font-mono text-3xl font-bold text-[#0B1F3A]/25">{item.num}</span>
            <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-sky-700">{item.enTitle}</p>
            <h2 data-i18n={`${item.id}Title`} class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl">{item.title}</h2>
            <p data-i18n={`${item.id}Desc`} class="mt-4 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </div>
          <div class="flex flex-col justify-center border-t border-slate-100 pt-6 lg:col-span-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <h3 data-i18n="srvHighlightsLabel" class="text-xs font-bold uppercase tracking-wider text-slate-400">Hạng mục triển khai chính</h3>
            <ul class="mt-4 space-y-3">
              {item.highlights.map((h) => (
                <li class="flex items-start gap-3 text-sm text-slate-700">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#0B1F3A]"></span>
                  <span data-i18n={`${item.id}${h}`}></span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal max-w-2xl">
        <p data-i18n="processEyebrow" class="text-xs font-bold uppercase tracking-[0.2em] text-[#0B1F3A]">03 / Quy trình làm việc</p>
        <h2 data-i18n="processTitle" class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">Quy trình triển khai chuẩn mực 4 bước</h2>
      </div>

      <div class="reveal-stagger mt-10 grid gap-6 md:grid-cols-4 md:gap-8">
        {processSteps.map((s) => (
          <div class="border-t-2 border-[#0B1F3A] bg-white p-6 shadow-xs">
            <span class="text-xs font-bold tracking-widest text-sky-700"><span data-i18n="stepLabel">BƯỚC</span> {s.step}</span>
            <h3 data-i18n={`${s.id}Title`} class="mt-2 text-lg font-bold text-slate-900">{s.title}</h3>
            <p data-i18n={`${s.id}Desc`} class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a href={`${base}/contact`} data-i18n="srvCta" class="inline-flex items-center gap-2 bg-[#0B1F3A] px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#173660]">
          Yêu cầu khảo sát & Báo giá giải pháp
        </a>
      </div>
    </div>
  </section>
</Layout>