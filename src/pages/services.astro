---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  {
    num: '01',
    title: 'Nông nghiệp tuần hoàn',
    enTitle: 'Circular Agriculture',
    desc: 'Chuyển giao hệ thống canh tác hữu cơ khép kín, biến phụ phẩm nông nghiệp và chất thải chăn nuôi thành phân bón sinh học chất lượng cao theo công nghệ vi sinh Nhật Bản.',
    highlights: [
      'Hệ thống lên men nhiệt cao khép kín, giảm thiểu mùi phát sinh',
      'Công nghệ vi sinh bản quyền từ đối tác Nhật Bản',
      'Tối ưu năng suất cây trồng và cải tạo độ phì nhiêu của đất',
    ],
  },
  {
    num: '02',
    title: 'Xử lý chất thải & Môi trường',
    enTitle: 'Environmental Engineering',
    desc: 'Thiết kế và lắp đặt hệ thống xử lý nước thải công nghiệp, rác thải hữu cơ và kiểm soát khí thải đáp ứng nghiêm ngặt quy chuẩn QCVN và tiêu chuẩn môi trường Nhật Bản.',
    highlights: [
      'Công nghệ màng lọc sinh học MBR & tái sử dụng nước đầu ra',
      'Thiết kế nhỏ gọn, tiết kiệm diện tích và điện năng vận hành',
      'Hệ thống cảm biến giám sát chất lượng nước tự động 24/7',
    ],
  },
  {
    num: '03',
    title: 'Tự động hóa & Sản xuất thông minh',
    enTitle: 'Smart Manufacturing',
    desc: 'Tư vấn cải tiến dây chuyền sản xuất theo triết lý Kaizen/Lean kết hợp tích hợp cảm biến IoT giúp doanh nghiệp kiểm soát chất lượng và giảm chi phí năng lượng.',
    highlights: [
      'Đánh giá điểm nghẽn dây chuyền và tối ưu bố trí nhà xưởng',
      'Tích hợp thiết bị đo lường, tự động hóa từ nhà sản xuất Nhật Bản',
      'Giảm tỷ lệ lỗi sản phẩm và nâng cao năng suất lao động',
    ],
  },
  {
    num: '04',
    title: 'Tư vấn & Đào tạo kỹ thuật',
    enTitle: 'Technical Advisory & Training',
    desc: 'Cầu nối trực tiếp giữa kỹ sư Nhật Bản và đội ngũ vận hành tại Việt Nam, đảm bảo quy trình chuyển giao diễn ra trơn tru và duy trì hiệu suất dài hạn.',
    highlights: [
      'Khảo sát thực địa cùng chuyên gia kỹ thuật Nhật Bản',
      'Biên soạn tài liệu hướng dẫn vận hành song ngữ Việt – Nhật',
      'Chính sách bảo trì định kỳ và hỗ trợ kỹ thuật xuyên suốt vòng đời dự án',
    ],
  },
];

const processSteps = [
  {
    step: '01',
    title: 'Khảo sát & Đánh giá',
    desc: 'Tiếp nhận bài toán, khảo sát thực địa tại nhà máy/trang trại và đo đạc thông số kỹ thuật đầu vào.',
  },
  {
    step: '02',
    title: 'Thiết kế giải pháp',
    desc: 'Phối hợp với đối tác Nhật Bản đề xuất công nghệ, bản vẽ kỹ thuật và dự toán tối ưu chi phí.',
  },
  {
    step: '03',
    title: 'Chuyển giao & Lắp đặt',
    desc: 'Nhập khẩu thiết bị chính hãng, thi công lắp đặt và chạy thử nghiệm đạt chuẩn cam kết.',
  },
  {
    step: '04',
    title: 'Đào tạo & Đồng hành',
    desc: 'Bàn giao quy trình, đào tạo kỹ sư vận hành tại chỗ và bảo trì định kỳ dài hạn.',
  },
];
---

<Layout title="Lĩnh vực & Dịch vụ | Công ty TNHH Japan-Tech">
  <!-- Page Header -->
  <section class="bg-[#0B1F3A] py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Services & Solutions</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Lĩnh vực công nghệ & Dịch vụ</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        Các giải pháp chuyển giao công nghệ được chọn lọc từ Nhật Bản và tinh chỉnh phù hợp với điều kiện vận hành tại Việt Nam.
      </p>
    </div>
  </section>

  <!-- Detailed Services List -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-6">
      {services.map((item) => (
        <div class="reveal grid gap-8 border border-slate-200 bg-white p-8 transition-colors hover:border-[#0B1F3A] lg:grid-cols-12 lg:p-10">
          <div class="lg:col-span-5">
            <span class="font-mono text-3xl font-bold text-[#0B1F3A]/25">{item.num}</span>
            <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-sky-700">{item.enTitle}</p>
            <h2 class="mt-1 text-2xl font-bold text-slate-900">{item.title}</h2>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </div>
          <div class="flex flex-col justify-center border-t border-slate-100 pt-6 lg:col-span-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Hạng mục triển khai chính</h3>
            <ul class="mt-4 space-y-3">
              {item.highlights.map((point) => (
                <li class="flex items-start gap-3 text-sm text-slate-700">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#0B1F3A]"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4-Step Workflow -->
  <section class="border-t border-slate-200 bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0B1F3A]">Workflow</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900">Quy trình tiếp cận & Triển khai</h2>
      </div>

      <div class="reveal mt-12 grid gap-8 md:grid-cols-4">
        {processSteps.map((s) => (
          <div class="border-t-2 border-[#0B1F3A] bg-white p-6 shadow-xs">
            <span class="text-xs font-bold tracking-widest text-sky-700">BƯỚC {s.step}</span>
            <h3 class="mt-2 text-lg font-bold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a
          href={`${base}/contact`}
          class="inline-flex items-center gap-2 bg-[#0B1F3A] px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#173660]"
        >
          Yêu cầu khảo sát & Báo giá giải pháp
        </a>
      </div>
    </div>
  </section>
</Layout>