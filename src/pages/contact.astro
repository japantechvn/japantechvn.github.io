---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Liên hệ | Công ty TNHH Japan-Tech">
  <!-- Page Header -->
  <section class="bg-[#0B1F3A] py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Contact Us</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Liên hệ hợp tác</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        Đội ngũ tư vấn kỹ thuật song ngữ Việt – Nhật của Japan-Tech luôn sẵn sàng tiếp nhận yêu cầu và đồng hành cùng doanh nghiệp của bạn.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal grid gap-12 lg:grid-cols-12">
        <!-- Left Info -->
        <div class="lg:col-span-5">
          <h2 class="text-2xl font-bold text-slate-900">Thông tin văn phòng</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Vui lòng điền biểu mẫu bên cạnh hoặc liên hệ trực tiếp qua hotline và email dưới đây. Chúng tôi phản hồi trong vòng 24 giờ làm việc.
          </p>

          <div class="mt-8 space-y-6 border-t border-slate-200 pt-8 text-sm">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Tên công ty</p>
              <p class="mt-1 font-semibold text-slate-900">Công ty TNHH Japan-Tech</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Địa chỉ trụ sở</p>
              <p class="mt-1 font-medium text-slate-800">TP. Hồ Chí Minh, Việt Nam (Điền địa chỉ cụ thể)</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Hotline</p>
              <p class="mt-1 font-medium text-slate-800">+84 (0) 900 000 000</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Email liên hệ</p>
              <p class="mt-1 font-medium text-slate-800">contact@japantech.vn</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Giờ làm việc</p>
              <p class="mt-1 font-medium text-slate-800">Thứ 2 – Thứ 6: 08:00 – 17:30</p>
            </div>
          </div>
        </div>

        <!-- Right Form -->
        <div class="border border-slate-200 bg-slate-50 p-8 lg:col-span-7">
          <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
  <!-- Replace with your real Web3Forms Access Key -->
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
  <input type="hidden" name="subject" value="Yêu cầu tư vấn mới từ website Japan-Tech" />
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Họ và tên *</label>
      <input type="text" name="name" required placeholder="Nguyễn Văn A" class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]" />
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Tên doanh nghiệp</label>
      <input type="text" name="company" placeholder="Công ty ABC" class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]" />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Email *</label>
      <input type="email" name="email" required placeholder="name@company.com" class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]" />
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Số điện thoại *</label>
      <input type="tel" name="phone" required placeholder="09xx xxx xxx" class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]" />
    </div>
  </div>

  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Lĩnh vực quan tâm</label>
    <select name="service" class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]">
      <option>Nông nghiệp tuần hoàn</option>
      <option>Xử lý chất thải & Môi trường</option>
      <option>Tự động hóa & Sản xuất thông minh</option>
      <option>Tư vấn chuyển giao công nghệ khác</option>
    </select>
  </div>

  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Nội dung yêu cầu *</label>
    <textarea name="message" rows="5" required placeholder="Mô tả ngắn gọn nhu cầu hoặc quy mô dự án của quý công ty..." class="mt-2 w-full border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-[#0B1F3A]"></textarea>
  </div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full cursor-pointer bg-[#0B1F3A] px-6 py-3.5 text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:bg-[#173660]"
  >
    Gửi yêu cầu tư vấn
  </button>
  <p id="form-status" class="hidden text-center text-sm font-medium"></p>
</form>
        </div>
      </div>

      <!-- Map Placeholder -->
      <div class="reveal mt-16 border border-slate-200 bg-slate-100 p-2">
        <div class="flex h-72 items-center justify-center bg-slate-200 text-sm text-slate-500">
          [ Khu vực nhúng Google Maps trụ sở Công ty TNHH Japan-Tech ]
        </div>
      </div>
    </div>
  </section>
</Layout>